# ── Authentication ────────────────────────────────────────────────────────
# Change IDE_PASS before deploying. The server logs a warning if it detects
# the default value. On AWS this is stored in Secrets Manager and injected
# automatically by the EC2 user_data bootstrap.
IDE_USER=admin
IDE_PASS=change-me-ide-pass

# ── LLM gateway ───────────────────────────────────────────────────────────
# Local vLLM (default — requires GPU on EC2):
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=none
LLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct-AWQ

# OpenAI fallback (for local dev without GPU):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

LLM_MAX_TOKENS=1500
LLM_TIMEOUT=120

# ── Sandbox ───────────────────────────────────────────────────────────────
SANDBOX_IMAGE=ide-sandbox
RUN_TIMEOUT=5
COMPILE_TIMEOUT=30

# ── Agent ─────────────────────────────────────────────────────────────────
AGENT_MAX_ITERS=5

# ── Local workspace (dev fallback when S3_BUCKET is not set) ─────────────
WORKSPACE_DIR=workspace

# ── Idle shutdown ─────────────────────────────────────────────────────────
ACTIVITY_FILE=/tmp/ide_last_activity
IDLE_MINUTES=30

# ── AWS ───────────────────────────────────────────────────────────────────
# Set on EC2 by user_data.sh; not needed for local dev.
AWS_REGION=ap-southeast-2

# S3 bucket for workspace files (leave blank for local filesystem fallback)
S3_BUCKET=tharun-gopinath-1086-CAD-DA2

# Secrets Manager ARN (read by user_data.sh at boot — not used by the app directly)
SECRET_ARN=

# ── Aurora PostgreSQL ─────────────────────────────────────────────────────
# Leave blank for local dev — run logging is silently skipped when DB_HOST is unset.
DB_HOST=
DB_PORT=5432
DB_NAME=agenticide
DB_USER=ideadmin
DB_PASS=change-me-db-pass
